@using NcpAdminAntBlazor.Client.Extensions
@using NcpAdminAntBlazor.Client.Infrastructure.Auth
@inject JwtAuthStateProvider JwtAuthStateProvider
@inject NavigationManager NavigationManager

<Dropdown Class="flex items-center">
    <Overlay>
        <Menu>
            <MenuItem Key="center">
                <Icon Type="user" Theme="@IconThemeType.Outline"/>
                个人中心
            </MenuItem>
            <MenuDivider/>
            <MenuItem Key="logout" OnClick="@OnLogoutAsync">
                <Icon Type="logout" Theme="@IconThemeType.Outline"/>
                退出登录
            </MenuItem>
        </Menu>
    </Overlay>

    <ChildContent>
        <Avatar Size="@AvatarSize.Default" Icon="user"/>
    </ChildContent>
</Dropdown>

@code
{
    private async Task OnLogoutAsync()
    {
        await JwtAuthStateProvider.NotifyLogoutAsync();
        NavigationManager.NavigateToLogin();
    }
}

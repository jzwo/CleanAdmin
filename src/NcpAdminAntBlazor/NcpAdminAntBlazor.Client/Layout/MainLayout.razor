@inherits LayoutComponentBase
@inject IJSRuntime JsRuntime
@inject ThemeService ThemeService
@using NcpAdminAntBlazor.Client.Services
@implements IDisposable

<Layout Class="h-dvh overflow-hidden">
    <Sider @bind-Collapsed="@_collapsed"
           CollapsedWidth="48"
           Class="border-r border-border bg-sider">
        <div class="flex items-center justify-center h-16">
            <div class="flex items-center gap-2">
                <svg class="w-8 h-8 text-blue-500" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L2 7L12 12L22 7L12 2Z" fill="currentColor" opacity="0.3"/>
                    <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                          stroke-linejoin="round"/>
                    <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                          stroke-linejoin="round"/>
                </svg>
                @if (!_collapsed)
                {
                    <span class="text-xl font-bold text-text">NcpAdmin</span>
                }
            </div>
        </div>
        <NavMenu></NavMenu>
    </Sider>
    <Layout>
        <Header Class="flex flex-col h-22 bg-appbar px-0">

            @* 顶部操作栏 *@
            <div class="h-12 px-4 border-b border-border items-center flex justify-between">

                @* 左侧区域 *@
                <Space Size="@("24")">
                    <SpaceItem>
                        <Icon Type="@(_collapsed ? IconType.Outline.MenuUnfold : IconType.Outline.MenuFold)"
                              OnClick="@CollapseToggle"/>
                    </SpaceItem>
                    <SpaceItem>
                        <Icon Component="@IconHelper.TailwindIcon("icon-[mdi--reload]")"/>
                    </SpaceItem>
                    <SpaceItem>
                        <Breadcrumb AutoGenerate>
                            <BreadcrumbItem Href="/">Home</BreadcrumbItem>
                        </Breadcrumb>
                    </SpaceItem>
                </Space>
                @* 右侧区域 *@
                <Space Size="@("24")">
                    <SpaceItem>
                        <Icon
                            Component="@IconHelper.TailwindIcon(_isDarkMode ? "icon-[tabler--moon-filled]" : "icon-[tabler--sun-filled]")"
                            OnClick="@ToggleTheme"/>
                    </SpaceItem>
                    <SpaceItem>
                        <CultureSelector/>
                    </SpaceItem>
                    <SpaceItem>
                        <Icon
                            Type="@(_isBrowserFullscreen ? IconType.Outline.FullscreenExit : IconType.Outline.Fullscreen)"
                            OnClick="@ToggleBrowserFullscreen"/>
                    </SpaceItem>
                    <SpaceItem>
                        <AvatarDropdown/>
                    </SpaceItem>
                </Space>
            </div>

            @* 标签页区域 *@
            <div class="h-10 items-center pb-0 border-b border-border">
                <ChromeStyleReuseTabs></ChromeStyleReuseTabs>
            </div>

        </Header>
        <Content Class="overflow-auto">
            @Body
        </Content>
        <Footer>Footer</Footer>
    </Layout>
</Layout>

@code {
    private bool _collapsed;
    private bool _isBrowserFullscreen;
    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private IJSObjectReference? _jsModule;
    private bool _isDarkMode;

    protected override async Task OnInitializedAsync()
    {
        _isDarkMode = await ThemeService.GetIsDarkAsync();
    }

    private void CollapseToggle()
    {
        _collapsed = !_collapsed;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import",
                "./js/AppLayout.js");
            await _jsModule.InvokeVoidAsync("registerFullscreenHandler", _dotNetRef);
        }
    }

    [JSInvokable]
    public void OnBrowserFullscreenChanged(bool isFullscreen)
    {
        _isBrowserFullscreen = isFullscreen;
        StateHasChanged();
    }

    private async Task ToggleBrowserFullscreen()
    {
        if (_jsModule is null) return;

        if (_isBrowserFullscreen)
        {
            await _jsModule.InvokeVoidAsync("exitFullscreen");
        }
        else
        {
            await _jsModule.InvokeVoidAsync("enterFullscreen");
        }
        // 状态由 fullscreenchange 事件监听器自动更新
    }

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        await ThemeService.SetThemeAsync(_isDarkMode ? ThemeMode.Dark : ThemeMode.Light);
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }

}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
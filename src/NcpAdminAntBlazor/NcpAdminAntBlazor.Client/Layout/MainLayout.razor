@inherits LayoutComponentBase

<Layout Class="h-dvh">
    <Sider @bind-Collapsed="@_collapsed"
           CollapsedWidth="48"
           Theme="SiderTheme.Light"
           Class="border-r border-border">
        <div class="flex items-center justify-center h-16">
            <div class="flex items-center gap-2">
                <svg class="w-8 h-8 text-blue-500" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L2 7L12 12L22 7L12 2Z" fill="currentColor" opacity="0.3"/>
                    <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                          stroke-linejoin="round"/>
                    <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                          stroke-linejoin="round"/>
                </svg>
                @if (!_collapsed)
                {
                    <span class="text-xl font-bold text-black">NcpAdmin</span>
                }
            </div>
        </div>
        <NavMenu></NavMenu>
    </Sider>
    <Layout>
        <Header Class="flex flex-col h-22 bg-white px-0">

            @* 顶部操作栏 *@
            <div class="h-12 px-4 border-b border-border items-center flex justify-between">

                @* 左侧区域 *@
                <Space Class="h-full" Size="@("24")">
                    <SpaceItem>
                        <Icon Type="@(_collapsed ? "menu-unfold" : "menu-fold")" OnClick="Toggle"/>
                    </SpaceItem>
                    <SpaceItem>
                        <Icon Type="reload" Theme="@IconThemeType.Outline"/>
                    </SpaceItem>
                    <SpaceItem>
                        <Breadcrumb AutoGenerate>
                            <BreadcrumbItem Href="/">Home</BreadcrumbItem>
                        </Breadcrumb>
                    </SpaceItem>
                </Space>
                @* 右侧区域 *@
                <Space Class="h-full" Size="@("24")">
                    <SpaceItem>
                        <Icon Type="@(_collapsed ? "menu-unfold" : "menu-fold")" OnClick="Toggle"/>
                    </SpaceItem>
                    <SpaceItem>
                        <Icon Type="reload" Theme="@IconThemeType.Outline"/>
                    </SpaceItem>
                </Space>
            </div>

            @* 标签页区域 *@
            <div class="h-10 items-center pb-0 border-b border-border">
                <ChromeStyleReuseTabs></ChromeStyleReuseTabs>
            </div>

        </Header>
        <Content>@Body</Content>
        <Footer>Footer</Footer>
    </Layout>
</Layout>

@code {
    private bool _collapsed;

    private void Toggle()
    {
        _collapsed = !_collapsed;
    }

}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
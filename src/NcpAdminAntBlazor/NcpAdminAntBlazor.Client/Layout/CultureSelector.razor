@using Microsoft.Extensions.Options
@inject IOptions<CultureOptions> CultureOptions
@inject ICultureService CultureService

<Dropdown Placement="@Placement.BottomRight">
    <Overlay>
        <Menu OnMenuItemClicked="ApplySelectedCultureAsync"
              DefaultSelectedKeys="@([_selectedCulture?.Name])">
            @foreach (var culture in _supportedCultures)
            {
                <MenuItem Key="@culture.Name">
                    @culture.NativeName
                </MenuItem>
            }
        </Menu>
    </Overlay>
    <ChildContent>
        <Button Type="@ButtonType.Text">
            <Icon Component="@IconHelper.TailwindIcon("icon-[heroicons-outline--translate]")"/>
        </Button>
    </ChildContent>
</Dropdown>

@code{
    private CultureInfo[] _supportedCultures = [];
    private CultureInfo? _selectedCulture;

    protected override void OnInitialized()
    {
        var supportedCultures = CultureOptions.Value.SupportedCultures;
        _supportedCultures = supportedCultures.Select(c => new CultureInfo(c)).ToArray();
        _selectedCulture = CultureInfo.CurrentCulture;
    }

    private async Task ApplySelectedCultureAsync(MenuItem arg)
    {
        var cultureName = arg.Key;
        if (!CultureInfo.CurrentCulture.Name.Equals(cultureName))
        {
            await CultureService.SetCultureAsync(cultureName);
        }
    }

}

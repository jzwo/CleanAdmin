@typeparam TModel where TModel : class, new()

<div class="@ContainerClass" style="@ContainerStyle">
    <PForm @ref="_form"
           TModel="TModel"
           Model="@Model"
           GridClass="w-full"
           Layout="FormLayout.Inline"
           LabelColSpan="@LabelColSpan"
           WrapperColSpan="@WrapperColSpan"
           Gutter="@Gutter"
           Loading="@Loading"
           ShowDefaultFooter="false"
           Collapsible="@(!DisableCollapse)"
           Collapsed="@(!_expanded)"
           CollapseCount="@CollapseCount"
           OnFinish="OnFinish">
        <ChildContent Context="context">
            @ChildContent(context)
            <GridCol Flex=@("auto")>
                <div class="flex justify-end">
                    <Space>
                        <SpaceItem>
                            <Button Type="@ButtonType.Primary"
                                    HtmlType="submit"
                                    Icon="@IconType.Outline.Search"
                                    Loading="@Loading">
                                @SearchText
                            </Button>
                        </SpaceItem>
                        <SpaceItem>
                            <Button OnClick="@HandleReset"
                                    Icon="@IconType.Outline.Reload"
                                    Disabled="@Loading">
                                @ResetText
                            </Button>
                        </SpaceItem>
                        @if (!DisableCollapse && _form?.FieldCount > CollapseCount)
                        {
                            <SpaceItem>
                                <Button OnClick="@ToggleExpand" Class="px-0" Type="@ButtonType.Link">
                                    @(_expanded ? CollapseText : ExpandText)
                                    <Icon Type="@(_expanded ? IconType.Outline.Up : IconType.Outline.Down)"></Icon>
                                </Button>
                            </SpaceItem>
                        }
                        @if (ExtraButtons != null)
                        {
                            @ExtraButtons
                        }
                    </Space>
                </div>
            </GridCol>
        </ChildContent>
    </PForm>
</div>

@code {
    private PForm<TModel>? _form;
    private bool _expanded;

    #region Form Parameters

    /// <summary>
    /// 搜索模型
    /// </summary>
    [Parameter, EditorRequired]
    public TModel Model { get; set; } = new();

    /// <summary>
    /// 标签列宽度
    /// </summary>
    [Parameter]
    public OneOf.OneOf<string, int> LabelColSpan { get; set; } = 6;

    /// <summary>
    /// 输入框列宽度
    /// </summary>
    [Parameter]
    public OneOf.OneOf<string, int> WrapperColSpan { get; set; } = 18;

    /// <summary>
    /// 是否正在加载
    /// </summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>
    /// 表单内容（在GridRow内部渲染）
    /// </summary>
    [Parameter, EditorRequired]
    public RenderFragment<TModel> ChildContent { get; set; } = default!;

    #endregion

    #region Container Parameters

    /// <summary>
    /// 容器样式类
    /// </summary>
    [Parameter]
    public string ContainerClass { get; set; } = "shrink-0 p-5 mb-4 bg-content-bg rounded-borderbase";

    /// <summary>
    /// 容器内联样式
    /// </summary>
    [Parameter]
    public string? ContainerStyle { get; set; }

    #endregion

    #region Grid Parameters

    /// <summary>
    /// Grid行间隔 (水平间隔, 垂直间隔)
    /// </summary>
    [Parameter]
    public (int, int) Gutter { get; set; } = (24, 12);

    #endregion

    #region Button Parameters

    /// <summary>
    /// 搜索按钮文字
    /// </summary>
    [Parameter]
    public string SearchText { get; set; } = "查询";

    /// <summary>
    /// 重置按钮文字
    /// </summary>
    [Parameter]
    public string ResetText { get; set; } = "重置";

    /// <summary>
    /// 展开按钮文字
    /// </summary>
    [Parameter]
    public string ExpandText { get; set; } = "展开";

    /// <summary>
    /// 收起按钮文字
    /// </summary>
    [Parameter]
    public string CollapseText { get; set; } = "收起";

    /// <summary>
    /// 是否禁用折叠功能
    /// </summary>
    [Parameter]
    public bool DisableCollapse { get; set; }

    /// <summary>
    /// 额外的按钮
    /// </summary>
    [Parameter]
    public RenderFragment? ExtraButtons { get; set; }

    #endregion

    #region Expand Parameters

    /// <summary>
    /// 默认显示的字段数量（折叠状态下）
    /// </summary>
    [Parameter]
    public int CollapseCount { get; set; } = 2;

    #endregion

    #region Events

    /// <summary>
    /// 搜索事件
    /// </summary>
    [Parameter]
    public EventCallback<EditContext> OnFinish { get; set; }

    /// <summary>
    /// 重置事件
    /// </summary>
    [Parameter]
    public EventCallback OnReset { get; set; }

    #endregion

    /// <summary>
    /// 获取表单引用
    /// </summary>
    public Form<TModel>? GetForm() => _form?.GetForm();

    /// <summary>
    /// 提交搜索
    /// </summary>
    public void Submit() => _form?.Submit();

    /// <summary>
    /// 重置表单
    /// </summary>
    public void Reset() => _form?.Reset();


    private async Task HandleReset()
    {
        Reset();
        await OnReset.InvokeAsync();
    }

    private void ToggleExpand()
    {
        _expanded = !_expanded;
    }

}



@using AntDesign.TableModels
@attribute [CascadingTypeParameter(nameof(TItem))]
@typeparam TItem
@implements IPTable

<div class="h-full flex flex-col">
    @if (SearchTemplate is not null && _searchFormVisible)
    {
        <div class="shrink-0 p-5 mb-4 bg-content-bg rounded-borderbase">
            <CascadingValue Value="this" IsFixed="true">
                @SearchTemplate
            </CascadingValue>
        </div>
    }
    <div class="px-4 flex-1 overflow-hidden bg-content-bg rounded-borderbase">
        <div class="flex items-center justify-between pb-2 pt-3 px-1">
            <div class="text-base font-medium pl-1">
                @Title
            </div>
            <div class="flex items-center gap-2">
                @if (ToolbarButtons is not null)
                {
                    @ToolbarButtons
                }
                @if (HasSearchForm)
                {
                    <Button Type="@(_searchFormVisible ? ButtonType.Primary : ButtonType.Default)"
                            Shape="ButtonShape.Circle"
                            OnClick="@(() => _searchFormVisible = !_searchFormVisible)">
                        <Icon Type="@IconType.Outline.Search"></Icon>
                    </Button>
                }
                <Button Disabled="@IsLoading" Shape="ButtonShape.Circle" OnClick="@ReloadData">
                    <Icon Type="@IconType.Outline.Reload" Spin="IsLoading"></Icon>
                </Button>
            </div>
        </div>
        <Table @ref="InternalTable"
               TItem="TItem"
               Total="_total"
               DataSource="_dataSource"
               ScrollY=""
               AutoHeight
               Loading="@IsLoading"
               @bind-PageSize="@_pageSize"
               PaginationPosition="bottomRight"
               OnChange="@HandleTableChangeAsync">
            <ChildContent>
                @ColumnDefinitions(context)
            </ChildContent>
        </Table>
    </div>
</div>

@code {
    private int _total;
    private IEnumerable<TItem> _dataSource = [];
    private bool HasSearchForm => SearchTemplate != null;
    private bool _searchFormVisible = true;
    private int _pageSize;

    protected override void OnParametersSet()
    {
        _pageSize = PageSize;
    }

    #region Parameters

    [Parameter] public RenderFragment? SearchTemplate { get; set; }

    [Parameter] public required RenderFragment<TItem> ColumnDefinitions { get; set; }

    [Parameter] public required Func<QueryModel<TItem>, Task<(int Total, IEnumerable<TItem> Data)>> OnLoadData { get; set; }

    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    [Parameter] public string? Title { get; set; }

    [Parameter] public RenderFragment? ToolbarButtons { get; set; }

    #endregion

    private async Task HandleTableChangeAsync(QueryModel<TItem> queryModel)
    {
        if (IsLoading) return;

        try
        {
            IsLoading = true;
            StateHasChanged();

            var (total, data) = await OnLoadData(queryModel);
            _total = total;
            _dataSource = data;
            if (PageSize != queryModel.PageSize)
            {
                await PageSizeChanged.InvokeAsync(queryModel.PageSize);
            }
        }
        finally
        {
            IsLoading = false;
        }
    }

    public Table<TItem> InternalTable { get; private set; } = null!;

    public void ReloadData()
    {
        InternalTable.ReloadData();
    }

    public bool IsLoading { get; private set; }

}
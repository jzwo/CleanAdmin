@page "/desktop"

<PageTitle>工作台</PageTitle>

<Card Title="工作台" Style="margin-bottom: 24px;">
    <ChildContent>
        <div style="margin-bottom: 16px;">
            <Text Strong>欢迎来到工作台</Text>
        </div>
        <Alert Type="@AlertType.Info"
               Message="工作台功能"
               Description="这里是您的个人工作台，可以查看待办事项、最新消息等内容。"
               ShowIcon="true"/>
    </ChildContent>
</Card>

<Row Gutter="16">
    <AntDesign.Col Span="8">
        <Card Title="待办事项" Style="margin-bottom: 24px;">
            <ChildContent>
                <p>暂无待办事项</p>
            </ChildContent>
        </Card>
    </AntDesign.Col>
    <AntDesign.Col Span="8">
        <Card Title="最新消息" Style="margin-bottom: 24px;">
            <ChildContent>
                <p>暂无新消息</p>
            </ChildContent>
        </Card>
    </AntDesign.Col>
    <AntDesign.Col Span="8">
        <Card Title="快速操作" Style="margin-bottom: 24px;">
            <ChildContent>
                <p>快速操作面板</p>
            </ChildContent>
        </Card>
    </AntDesign.Col>
</Row>

@page "/teams"

<PageTitle>团队列表</PageTitle>

<div style="padding: 24px;">
    <Card Title="团队列表" Style="margin-bottom: 24px;">
        <Extra>
            <Space>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Plus">
                        新增团队
                    </Button>
                </SpaceItem>
            </Space>
        </Extra>
        <ChildContent>
            <Table TItem="TeamItem" DataSource="@_teams" Loading="@_loading">
                <PropertyColumn Property="c => c.Id" Title="ID"/>
                <PropertyColumn Property="c => c.Name" Title="团队名称"/>
                <PropertyColumn Property="c => c.Leader" Title="团队负责人"/>
                <PropertyColumn Property="c => c.MemberCount" Title="成员数"/>
                <PropertyColumn Property="c => c.Description" Title="描述"/>
                <ActionColumn Title="操作">
                    <Space>
                        <SpaceItem>
                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link">查看</Button>
                        </SpaceItem>
                        <SpaceItem>
                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link">编辑</Button>
                        </SpaceItem>
                        <SpaceItem>
                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" Danger>删除</Button>
                        </SpaceItem>
                    </Space>
                </ActionColumn>
            </Table>
        </ChildContent>
    </Card>
</div>

@code {
    private bool _loading;
    private List<TeamItem> _teams = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        await Task.Delay(500); // 模拟加载
        _teams = new List<TeamItem>
        {
            new TeamItem { Id = 1, Name = "开发团队", Leader = "张三", MemberCount = 10, Description = "负责产品开发" },
            new TeamItem { Id = 2, Name = "测试团队", Leader = "李四", MemberCount = 5, Description = "负责产品测试" },
            new TeamItem { Id = 3, Name = "运维团队", Leader = "王五", MemberCount = 3, Description = "负责系统运维" }
        };
        _loading = false;
    }

    public class TeamItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Leader { get; set; } = string.Empty;
        public int MemberCount { get; set; }
        public string Description { get; set; } = string.Empty;
    }
}

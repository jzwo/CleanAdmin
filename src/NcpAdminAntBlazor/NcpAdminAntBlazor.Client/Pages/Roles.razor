@page "/roles"

<PageTitle>角色管理</PageTitle>

<div style="padding: 24px;">
    <Card Title="角色管理" Style="margin-bottom: 24px;">
        <Extra>
            <Space>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Plus">
                        新增角色
                    </Button>
                </SpaceItem>
            </Space>
        </Extra>
        <ChildContent>
            <Table TItem="RoleItem" DataSource="@_roles" Loading="@_loading">
                <PropertyColumn Property="c => c.Id" Title="ID"/>
                <PropertyColumn Property="c => c.Name" Title="角色名称"/>
                <PropertyColumn Property="c => c.Description" Title="描述"/>
                <PropertyColumn Property="c => c.UserCount" Title="用户数"/>
                <ActionColumn Title="操作">
                    <Space>
                        <SpaceItem>
                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link">编辑</Button>
                        </SpaceItem>
                        <SpaceItem>
                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link">权限配置</Button>
                        </SpaceItem>
                        <SpaceItem>
                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" Danger>删除</Button>
                        </SpaceItem>
                    </Space>
                </ActionColumn>
            </Table>
        </ChildContent>
    </Card>
</div>

@code {
    private bool _loading;
    private List<RoleItem> _roles = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        await Task.Delay(500); // 模拟加载
        _roles = new List<RoleItem>
        {
            new RoleItem { Id = 1, Name = "管理员", Description = "系统管理员角色", UserCount = 5 },
            new RoleItem { Id = 2, Name = "普通用户", Description = "普通用户角色", UserCount = 50 },
            new RoleItem { Id = 3, Name = "访客", Description = "访客角色", UserCount = 100 }
        };
        _loading = false;
    }

    public class RoleItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public int UserCount { get; set; }
    }
}

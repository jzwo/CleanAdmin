@page "/permissions"

<PageTitle>权限管理</PageTitle>

<div style="padding: 24px;">
    <Card Title="权限管理" Style="margin-bottom: 24px;">
        <Extra>
            <Space>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Plus">
                        新增权限
                    </Button>
                </SpaceItem>
            </Space>
        </Extra>
        <ChildContent>
            <Table TItem="PermissionItem" DataSource="@_permissions" Loading="@_loading">
                <PropertyColumn Property="c => c.Id" Title="ID"/>
                <PropertyColumn Property="c => c.Name" Title="权限名称"/>
                <PropertyColumn Property="c => c.Code" Title="权限代码"/>
                <PropertyColumn Property="c => c.Category" Title="分类"/>
                <PropertyColumn Property="c => c.Description" Title="描述"/>
                <ActionColumn Title="操作">
                    <Space>
                        <SpaceItem>
                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link">编辑</Button>
                        </SpaceItem>
                        <SpaceItem>
                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" Danger>删除</Button>
                        </SpaceItem>
                    </Space>
                </ActionColumn>
            </Table>
        </ChildContent>
    </Card>
</div>

@code {
    private bool _loading;
    private List<PermissionItem> _permissions = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        await Task.Delay(500); // 模拟加载
        _permissions = new List<PermissionItem>
        {
            new PermissionItem { Id = 1, Name = "用户管理", Code = "user.manage", Category = "用户", Description = "管理用户信息" },
            new PermissionItem { Id = 2, Name = "角色管理", Code = "role.manage", Category = "用户", Description = "管理角色信息" },
            new PermissionItem { Id = 3, Name = "权限管理", Code = "permission.manage", Category = "用户", Description = "管理权限信息" },
            new PermissionItem { Id = 4, Name = "团队管理", Code = "team.manage", Category = "团队", Description = "管理团队信息" },
            new PermissionItem { Id = 5, Name = "文件管理", Code = "file.manage", Category = "文件", Description = "管理文件信息" }
        };
        _loading = false;
    }

    public class PermissionItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}

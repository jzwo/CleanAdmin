@page "/users"

<PageTitle>用户列表</PageTitle>

<div style="padding: 24px;">
    <Card Title="用户列表" Style="margin-bottom: 24px;">
        <Extra>
            <Space>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Plus">
                        新增用户
                    </Button>
                </SpaceItem>
            </Space>
        </Extra>
        <ChildContent>
            <Table TItem="UserItem" DataSource="@_users" Loading="@_loading">
                <PropertyColumn Property="c => c.Id" Title="ID"/>
                <PropertyColumn Property="c => c.Name" Title="姓名"/>
                <PropertyColumn Property="c => c.Email" Title="邮箱"/>
                <PropertyColumn Property="c => c.Role" Title="角色"/>
                <ActionColumn Title="操作">
                    <Space>
                        <SpaceItem>
                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link">编辑</Button>
                        </SpaceItem>
                        <SpaceItem>
                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" Danger>删除</Button>
                        </SpaceItem>
                    </Space>
                </ActionColumn>
            </Table>
        </ChildContent>
    </Card>
</div>

@code {
    private bool _loading;
    private List<UserItem> _users = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        await Task.Delay(500); // 模拟加载
        _users = new List<UserItem>
        {
            new UserItem { Id = 1, Name = "张三", Email = "zhangsan@example.com", Role = "管理员" },
            new UserItem { Id = 2, Name = "李四", Email = "lisi@example.com", Role = "普通用户" },
            new UserItem { Id = 3, Name = "王五", Email = "wangwu@example.com", Role = "普通用户" }
        };
        _loading = false;
    }

    public class UserItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
    }
}

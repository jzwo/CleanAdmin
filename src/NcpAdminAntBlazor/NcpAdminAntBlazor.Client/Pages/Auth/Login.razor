@page "/login"
@using Console = System.Console
@inject IStringLocalizer<Login> L
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>@L["PageTitle"]</PageTitle>

<Title Level="4" Class="mb-6">密码登录</Title>

<Form Model="@_model"
      OnFinish="OnFinish">
    <FluentValidator/>
    <FormItem>
        <AntDesign.Input @bind-Value="@context.Username"
                         Placeholder="@L["UsernamePlaceholder"].Value"
                         Size="InputSize.Large">
            <Prefix>
                <Icon Type="user"/>
            </Prefix>
        </AntDesign.Input>
    </FormItem>

    <FormItem>
        <InputPassword @bind-Value="@context.Password"
                       Placeholder="@L["PasswordPlaceholder"].Value"
                       Size="InputSize.Large"
                       VisibilityToggle="true">
            <Prefix>
                <Icon Type="lock"/>
            </Prefix>
        </InputPassword>
    </FormItem>

    <FormItem>
        <Flex Justify="FlexJustify.SpaceBetween" Align="FlexAlign.Center">
            <Checkbox @bind-Value="_model.RememberMe">
                @L["RememberMe"]
            </Checkbox>
            <a href="#">@L["ForgotPassword"]</a>
        </Flex>
    </FormItem>

    <FormItem>
        <Button Type="@ButtonType.Primary"
                HtmlType="submit"
                Block="true"
                Size="ButtonSize.Large"
                Loading="@_loading">
            @L["ConfirmButton"]
        </Button>
    </FormItem>

    <FormItem>
        <Flex Gap="FlexGap.Middle">
            <Button Block="true" Size="ButtonSize.Large">
                @L["CodeLogin"]
            </Button>
            <Button Block="true" Size="ButtonSize.Large">
                @L["Register"]
            </Button>
        </Flex>
    </FormItem>
</Form>

@code {
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private readonly LoginModel _model = new();
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated is true)
        {
            NavigationManager.NavigateTo(Home.PageUri);
        }
    }


    private async Task OnFinish(EditContext editContext)
    {
        _loading = true;
        try
        {
            // TODO: 实现登录逻辑
            await Task.Delay(1000);
            Console.WriteLine($"登录成功: {_model.Username}");
        }
        finally
        {
            _loading = false;
        }
    }


}

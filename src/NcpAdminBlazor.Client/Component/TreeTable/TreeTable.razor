@typeparam TItem

<MudTable Items="@_flatItems"
          Hover
          Dense
          Outlined
          Filter="ItemIsVisible"
          Class="@Class"
          Style="@Style">
    <HeaderContent>
        @HeaderContent
    </HeaderContent>
    <RowTemplate Context="wrapper">
        @RowTemplate(wrapper)
    </RowTemplate>
    <PagerContent>
        @PagerContent
    </PagerContent>
</MudTable>

@code {
    [Parameter] public required IEnumerable<TItem> Items { get; set; }
    [Parameter] public required Func<TItem, IEnumerable<TItem>?> Children { get; set; }
    [Parameter] public required RenderFragment HeaderContent { get; set; }
    [Parameter] public required RenderFragment<TreeItemContext<TItem>> RowTemplate { get; set; }

    [Parameter] public RenderFragment? PagerContent { get; set; }
    [Parameter] public int IndentSize { get; set; } = 24;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string Style { get; set; } = string.Empty;

    private readonly List<TreeItemContext<TItem>> _flatItems = [];

    protected override void OnParametersSet()
    {
        BuildFlatList();
    }

    private void BuildFlatList()
    {
        _flatItems.Clear();
        foreach (var item in Items)
        {
            AddNode(item, 0, null);
        }
    }

    private void AddNode(TItem item, int level, TreeItemContext<TItem>? parent)
    {
        var context = new TreeItemContext<TItem>
        {
            Item = item,
            Level = level,
            Parent = parent,
            IsExpanded = false,
            IndentSize = IndentSize,
            IsVisible = parent is null or { IsExpanded: true, IsVisible: true },
            // 绑定回调：当 Context 调用 Toggle 时，执行组件内的 ToggleNode 方法
            ToggleAction = ToggleNode
        };

        _flatItems.Add(context);

        parent?.ChildContextsWrappers.Add(context);

        var children = Children(item);
        if (children is null) return;

        var hasChildren = false;

        foreach (var child in children)
        {
            if (!hasChildren)
            {
                hasChildren = true;
                context.HasChildren = true;
            }

            AddNode(child, level + 1, context);
        }
    }

    private void ToggleNode(TreeItemContext<TItem> context)
    {
        context.IsExpanded = !context.IsExpanded;
        UpdateChildrenVisibility(context);
        StateHasChanged();
    }

    private static void UpdateChildrenVisibility(TreeItemContext<TItem> parent)
    {
        foreach (var child in parent.ChildContextsWrappers)
        {
            child.IsVisible = parent is { IsVisible: true, IsExpanded: true };
            if (child.HasChildren)
            {
                UpdateChildrenVisibility(child);
            }
        }
    }

    private static bool ItemIsVisible(TreeItemContext<TItem> context) => context.IsVisible;
}
@inject IStringLocalizer<AppBarQuickLinks> L

<Dropdown Trigger="@(new[] { Trigger.Click })" Placement="@Placement.BottomRight">
    <Overlay>
        <Menu>
            <MenuItem Key="project-github">
                <a href="https://github.com/jzwo/CleanAdmin" target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-2">
                    <iconify-icon icon="mdi:github"></iconify-icon>
                    <span>@L["Project GitHub"]</span>
                </a>
            </MenuItem>
            <MenuItem Key="antblazor-github">
                <a href="https://github.com/ant-design-blazor/ant-design-blazor" target="_blank"
                   rel="noopener noreferrer" class="inline-flex items-center gap-2">
                    <iconify-icon icon="simple-icons:antdesign"></iconify-icon>
                    <span>@L["Ant Design Blazor"]</span>
                </a>
            </MenuItem>
            <MenuItem Key="netcorepal-github">
                <a href="https://github.com/netcorepal/netcorepal-cloud-framework" target="_blank"
                   rel="noopener noreferrer" class="inline-flex items-center gap-2">
                    <iconify-icon icon="material-icon-theme:folder-netcore"></iconify-icon>
                    <span>@L["NetCorePal"]</span>
                </a>
            </MenuItem>
        </Menu>
    </Overlay>
    <ChildContent>
        <Button Type="@ButtonType.Text">
            <Icon Component="@IconHelper.TailwindIcon("icon-[heroicons-outline--link]")"/>
        </Button>
    </ChildContent>
</Dropdown>

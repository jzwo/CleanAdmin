@inherits LayoutComponentBase
@using CleanAdmin.Web.Client.Services.State

@inject IJSRuntime Js
@inject FullscreenState FullscreenState
@inject IStringLocalizer<MainLayout> L

@implements IAsyncDisposable

<Layout Class="h-dvh overflow-hidden">
    <Sider @bind-Collapsed="@_collapsed"
           CollapsedWidth="48"
           Width="220"
           class="@($"{(FullscreenState.IsFullscreen ? "hidden" : "")} border-r border-border bg-sider")">
        <div class="flex items-center justify-center h-14">
            <div class="flex items-center gap-2">
                <CleanAdminLogo/>
                @if (!_collapsed)
                {
                    <span class="text-xl font-medium text-text">@L["Clean Admin"]</span>
                }
            </div>
        </div>
        <NavMenu></NavMenu>
    </Sider>
    <Layout>
        <Header
            Class="@($"{(FullscreenState.IsFullscreen ? "hidden" : "")} h-12 px-2 border-b border-border flex items-center bg-appbar")">
            <Button Type="@ButtonType.Text" OnClick="@CollapseToggle">
                <Icon
                    Component="@(_collapsed ? IconHelper.TailwindIcon("icon-[ri--menu-fold-4-line]") : IconHelper.TailwindIcon("icon-[ri--menu-unfold-4-line]"))"/>
            </Button>
            <AutoBreadcrumb/>

            <div class="h-full flex items-center justify-end">
                <AppBarQuickLinks/>
                <ThemeToggle/>
                <CultureSelector/>
                <Button Type="@ButtonType.Text" OnClick="@ToggleBrowserFullscreen">
                    <Icon
                        Component="@(_isBrowserFullscreen ? IconHelper.TailwindIcon("icon-[gridicons--fullscreen-exit]") : IconHelper.TailwindIcon("icon-[gridicons--fullscreen]"))"/>
                </Button>
                <AvatarDropdown/>
            </div>
        </Header>
        <Content>
            <ChromeStyleReuseTabs/>
        </Content>
    </Layout>
</Layout>

@code {
    private bool _collapsed;

    private bool _isBrowserFullscreen;
    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./Layout/MainLayout.razor.js");
            _dotNetRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("registerFullscreenChange", _dotNetRef);
            _isBrowserFullscreen = await _module.InvokeAsync<bool>("isFullscreen");

            FullscreenState.OnChanged += OnFullscreenStateChanged;
        }
    }

    [JSInvokable]
    public Task OnBrowserFullscreenChanged(bool isFullscreen)
    {
        _isBrowserFullscreen = isFullscreen;
        return InvokeAsync(StateHasChanged);
    }

    private void OnFullscreenStateChanged()
    {
        StateHasChanged();
    }

    private void CollapseToggle()
    {
        _collapsed = !_collapsed;
    }

    private async Task ToggleBrowserFullscreen()
    {
        if (_module is null)
            return;

        if (!_isBrowserFullscreen)
        {
            await _module.InvokeVoidAsync("request");
        }
        else
        {
            await _module.InvokeVoidAsync("exit");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("unregisterFullscreenChange");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            _module = null;
        }

        FullscreenState.OnChanged -= OnFullscreenStateChanged;
        _dotNetRef?.Dispose();
    }

}

<div id="blazor-error-ui" data-nosnippet>
    @L["An unhandled error has occurred."]
    <a href="." class="reload">@L["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

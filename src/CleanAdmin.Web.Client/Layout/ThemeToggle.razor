@inject ThemeService ThemeService
<Button Type="@ButtonType.Text" OnClick="@ToggleTheme">
    <Icon
        Component="@IconHelper.TailwindIcon(_isDarkMode ? "icon-[tabler--moon-filled]" : "icon-[tabler--sun-filled]")"/>
</Button>

@code {
    private bool _isDarkMode;

    protected override async Task OnInitializedAsync()
    {
        _isDarkMode = await ThemeService.GetIsDarkAsync();
    }

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        await ThemeService.SetThemeAsync(_isDarkMode ? ThemeMode.Dark : ThemeMode.Light);
    }

}

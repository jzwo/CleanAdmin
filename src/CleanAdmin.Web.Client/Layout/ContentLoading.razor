@inject IStringLocalizer<ContentLoading> L

@if (!RendererInfo.IsInteractive)
{
    <div class="relative min-h-screen bg-body-bg">
        <div class="absolute right-6 top-6 opacity-90">
            <Spin />
        </div>

        <div class="flex min-h-screen items-center justify-center px-6">
            <div class="flex flex-col items-center gap-7">
                <CleanAdminLogo Class="h-24 w-24" />
                <Spin Size="SpinSize.Large" Spinning="true" />
                <Text Class="text-3xl" Type="TextElementType.Secondary">@L["Clean Admin"]</Text>
            </div>
        </div>
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

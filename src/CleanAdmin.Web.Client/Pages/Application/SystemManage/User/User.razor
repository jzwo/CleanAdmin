@page "/SystemManage/User"
@using CleanAdmin.Web.Client.ApiSdk
@using AntDesign.TableModels
@using UserListItemDto = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceApplicationQueriesUsersUserListItemDto
@using SearchQueryParameters = CleanAdmin.Web.Client.ApiSdk.Api.User.List.ListRequestBuilder.ListRequestBuilderGetQueryParameters
@inject ApiClient ApiClient
@inject IMessageService MessageService
@inject IStringLocalizer<User> L

<PageTitle>@L["User Management"]</PageTitle>

<PTable @ref="_pTable" TItem="UserListItemDto"
        Title='@L["User List"]'
        OnLoadData="LoadDataAsync">
    <SearchTemplate>
        <PTableSearchForm TModel="SearchQueryParameters" Model="_searchModel">
            <PFormItem Label='@L["Username"]'>
                <Input @bind-Value="@_searchModel.Username" Placeholder='@L["Please enter username"]' AllowClear/>
            </PFormItem>
            <PFormItem Label='@L["Real Name"]'>
                <Input @bind-Value="@_searchModel.RealName" Placeholder='@L["Please enter real name"]' AllowClear/>
            </PFormItem>
            <PFormItem Label='@L["Email"]'>
                <Input @bind-Value="@_searchModel.Email" Placeholder='@L["Please enter email"]' AllowClear/>
            </PFormItem>
            <PFormItem Label='@L["Phone"]'>
                <Input @bind-Value="@_searchModel.Phone" Placeholder='@L["Please enter phone"]' AllowClear/>
            </PFormItem>
        </PTableSearchForm>
    </SearchTemplate>
    <ToolbarButtons>
        <UserCreateDrawer/>
    </ToolbarButtons>
    <ColumnDefinitions Context="item">
        <PropertyColumn Property="c => c.Username" Title='@L["Username"]'/>
        <PropertyColumn Property="c => c.RealName" Title='@L["Real Name"]'/>
        <PropertyColumn Property="c => c.Email" Title='@L["Email"]'/>
        <PropertyColumn Property="c => c.Phone" Title='@L["Phone"]'/>
        <PropertyColumn Property="c => c.CreatedAt" Title='@L["Created Time"]' Format="yyyy-MM-dd HH:mm:ss"/>
        <ActionColumn Title='@L["Actions"]' Width="180">
            <Space>
                <SpaceItem>
                    <UserEditDrawer User="@item"/>
                </SpaceItem>
                <SpaceItem>
                    <Popconfirm Title='@L["Are you sure to delete this user?"]'
                                OnConfirm="() => OnDelete(item)"
                                OkText='@L["Confirm"]'
                                CancelText='@L["Cancel"]'>
                        <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" Danger>
                            @L["Delete"]
                        </Button>
                    </Popconfirm>
                </SpaceItem>
            </Space>
        </ActionColumn>
    </ColumnDefinitions>
</PTable>


@code {
    private PTable<UserListItemDto>? _pTable;
    private readonly SearchQueryParameters _searchModel = new();

    /// <summary>
    /// PTable 数据加载回调
    /// </summary>
    private async Task<(int Total, IEnumerable<UserListItemDto> Data)> LoadDataAsync(
        QueryModel<UserListItemDto> queryModel)
    {
        try
        {
            var response = await ApiClient.Api.User.List.GetAsync(config =>
            {
                config.QueryParameters.PageIndex = queryModel.PageIndex;
                config.QueryParameters.PageSize = queryModel.PageSize;
                config.QueryParameters.CountTotal = true;
                config.QueryParameters.Username = string.IsNullOrWhiteSpace(_searchModel.Username) ? null : _searchModel.Username;
                config.QueryParameters.RealName = string.IsNullOrWhiteSpace(_searchModel.RealName) ? null : _searchModel.RealName;
                config.QueryParameters.Email = string.IsNullOrWhiteSpace(_searchModel.Email) ? null : _searchModel.Email;
                config.QueryParameters.Phone = string.IsNullOrWhiteSpace(_searchModel.Phone) ? null : _searchModel.Phone;
            });

            if (response is { Success: true, Data: { } data })
            {
                return (data.Total ?? 0, data.Items?.ToList() ?? []);
            }
            else
            {
                await MessageService.ErrorAsync(response?.Message ?? $"{L["Failed to get user list"]}");
                return (0, []);
            }
        }
        catch (Exception ex)
        {
            await MessageService.ErrorAsync($"{L["Failed to get user list"]}: {ex.Message}");
            return (0, []);
        }
    }

    private async Task OnDelete(UserListItemDto user)
    {
        try
        {
            var response = await ApiClient.Api.User[user.Id!].DeletePath.DeleteAsync();
            if (response is { Success: true })
            {
                await MessageService.SuccessAsync($"{L["Deleted successfully"]}");
                _pTable?.ReloadData();
            }
            else
            {
                await MessageService.ErrorAsync(response?.Message ?? $"{L["Delete failed"]}");
            }
        }
        catch (Exception ex)
        {
            await MessageService.ErrorAsync($"{L["Delete failed"]}: {ex.Message}");
        }
    }


}

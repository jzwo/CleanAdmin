@using CleanAdmin.Web.Client.ApiSdk
@using CreateUserRequest = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceEndpointsUsersCreateUserRequest
@inject ApiClient ApiClient
@inject IStringLocalizer<UserCreateDrawer> L

<PDrawerForm TModel="CreateUserRequest"
             Title='@L["Create User"]'
             Model="_model"
             OnSubmit="@HandleSubmitAsync">
    <Activator>
        <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Plus">@L["Create"]</Button>
    </Activator>
    <ChildContent Context="model">
        <PFormItem Label='@L["Username"]' Required>
            <Input @bind-Value="@model.Username" Placeholder='@L["Please enter username"]'/>
        </PFormItem>
        <PFormItem Label='@L["Password"]' Required>
            <InputPassword @bind-Value="@model.Password" Placeholder='@L["Please enter password"]'/>
        </PFormItem>
        <PFormItem Label='@L["Real Name"]' Required>
            <Input @bind-Value="@model.RealName" Placeholder='@L["Please enter real name"]'/>
        </PFormItem>
        <PFormItem Label='@L["Email"]'
                   Rules="@(
                          [
                              new FormValidationRule { Required = true, Message = $"{L["Please enter email"]}" },
                              new FormValidationRule { Type = FormFieldType.Email, Message = $"{L["Please enter a valid email address"]}" }
                          ])">
            <Input @bind-Value="@model.Email" Placeholder='@L["Please enter email"]'/>
        </PFormItem>
        <PFormItem Label='@L["Phone"]'>
            <Input @bind-Value="@model.Phone" Placeholder='@L["Please enter phone"]'/>
        </PFormItem>
    </ChildContent>
</PDrawerForm>

@code {
    private readonly CreateUserRequest _model = new();

    private async Task<(bool, string?)> HandleSubmitAsync(CreateUserRequest model)
    {
        var response = await ApiClient.Api.Users.PostAsync(model);
        return response is { Success: true } ? (true, null) : (false, response?.Message);
    }

}

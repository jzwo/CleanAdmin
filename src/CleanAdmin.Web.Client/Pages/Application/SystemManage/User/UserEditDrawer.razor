@using CleanAdmin.Web.Client.ApiSdk
@using AssignableRoleItemDto = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceEndpointsUsersUserAssignableRoleItemResponse
@using UpdateUserRequest = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceEndpointsUsersUpdateUserRequest
@using UserListItemDto = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceApplicationQueriesUsersUserListItemDto
@inject ApiClient ApiClient
@inject IMessageService MessageService
@inject IStringLocalizer<UserEditDrawer> L

<PDrawerForm TModel="UpdateUserRequest"
             Title='@L["Edit User"]'
             Model="_model"
             @bind-Visible="_visible"
             OnSubmit="@HandleSubmitAsync">
    <ChildContent Context="model">
        @if (_loadingEditContext)
        {
            <div class="py-4 text-center">
                <Spin/>
            </div>
        }
        else
        {
            <PFormItem Label='@L["Username"]' Required>
                <Input @bind-Value="@model.Username" Placeholder='@L["Please enter username"]'/>
            </PFormItem>
            <PFormItem Label='@L["Real Name"]' Required>
                <Input @bind-Value="@model.RealName" Placeholder='@L["Please enter real name"]'/>
            </PFormItem>
            <PFormItem Label='@L["Email"]'
                       Rules="@(new[]
                              {
                                  new FormValidationRule { Required = true, Message = $"{L["Please enter email"]}" },
                                  new FormValidationRule { Type = FormFieldType.Email, Message = $"{L["Please enter a valid email address"]}" }
                              })">
                <Input @bind-Value="@model.Email" Placeholder='@L["Please enter email"]'/>
            </PFormItem>
            <PFormItem Label='@L["Phone"]'>
                <Input @bind-Value="@model.Phone" Placeholder='@L["Please enter phone"]'/>
            </PFormItem>
            <PFormItem Label='@L["Roles"]'>
                <Select Mode="SelectMode.Multiple"
                        Placeholder='@L["Please select roles"]'
                        @bind-Values="_assignedRoleIds"
                        TItemValue="string"
                        TItem="string"
                        EnableSearch
                        AllowClear
                        Style="width: 100%;">
                    <SelectOptions>
                        @foreach (var role in _assignableRoles)
                        {
                            <SelectOption TItemValue="string"
                                          TItem="string"
                                          Value="@(role.RoleId ?? string.Empty)"
                                          Label="@(role.RoleName ?? string.Empty)"/>
                        }
                    </SelectOptions>
                </Select>
            </PFormItem>
        }
    </ChildContent>
</PDrawerForm>

@code {
    private string? _currentEditUserId;
    private bool _loadingEditContext;
    private bool _visible;
    private UpdateUserRequest _model = new();
    private List<AssignableRoleItemDto> _assignableRoles = [];
    private IEnumerable<string> _assignedRoleIds = [];

    public async Task OpenAsync(UserListItemDto user)
    {
        _currentEditUserId = user.Id;
        _loadingEditContext = true;
        _visible = true;

        await InvokeAsync(StateHasChanged);

        try
        {
            var assignableRolesResponse = await ApiClient.Api.User.Roles.Assignable.GetAsync();

            if (assignableRolesResponse is not { Success: true })
            {
                _assignableRoles = [];
                _ = MessageService.ErrorAsync(assignableRolesResponse?.Message ?? $"{L["Failed to get assignable roles"]}");
            }
            else
            {
                _assignableRoles = assignableRolesResponse.Data ?? [];
            }

            var assignedRoleIds = user.Roles?
                .Select(r => r.RoleId)
                .Where(roleId => !string.IsNullOrWhiteSpace(roleId))
                .Select(roleId => roleId!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList() ?? [];

            _assignedRoleIds = assignedRoleIds;
            _model = new UpdateUserRequest
            {
                Username = user.Username,
                RealName = user.RealName,
                Email = user.Email,
                Phone = user.Phone,
                AssignedRoleIds = assignedRoleIds
            };
        }
        catch (Exception ex)
        {
            _model = new UpdateUserRequest
            {
                Username = user.Username,
                RealName = user.RealName,
                Email = user.Email,
                Phone = user.Phone,
                AssignedRoleIds = []
            };
            _assignableRoles = [];
            _assignedRoleIds = [];
            _ = MessageService.ErrorAsync($"{L["Failed to load edit data"]}: {ex.Message}");
        }
        finally
        {
            _loadingEditContext = false;
        }
    }

    private async Task<(bool, string?)> HandleSubmitAsync(UpdateUserRequest model)
    {
        if (string.IsNullOrEmpty(_currentEditUserId))
        {
            return (false, $"{L["User ID cannot be empty"]}");
        }

        model.AssignedRoleIds = _assignedRoleIds
            .Where(roleId => !string.IsNullOrWhiteSpace(roleId))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var response = await ApiClient.Api.User[_currentEditUserId].Update.PostAsync(model);
        return response is { Success: true } ? (true, null) : (false, response?.Message);
    }

}

@page "/SystemManage/Role"
@using CleanAdmin.Web.Client.ApiSdk
@using AntDesign.TableModels
@using RoleListItemDto = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceApplicationQueriesRolesRoleListItemDto
@using SearchQueryParameters = CleanAdmin.Web.Client.ApiSdk.Api.Roles.RolesRequestBuilder.RolesRequestBuilderGetQueryParameters
@inject ApiClient ApiClient
@inject IMessageService MessageService
@inject IStringLocalizer<Role> L

<PageTitle>@L["Role Management"]</PageTitle>

<PTable @ref="_pTable" TItem="RoleListItemDto"
        Title='@L["Role List"]'
        OnLoadData="LoadDataAsync">
    <SearchTemplate>
        <PTableSearchForm TModel="SearchQueryParameters" Model="_searchModel">
            <PFormItem Label='@L["Role Name"]'>
                <Input @bind-Value="@_searchModel.Name" Placeholder='@L["Please enter role name"]' AllowClear/>
            </PFormItem>
        </PTableSearchForm>
    </SearchTemplate>
    <ToolbarButtons>
        <PermissionView Code="@AppPermissions.System_Roles_Create">
            <RoleCreateDrawer OnSuccess="OnRoleChangedAsync"/>
        </PermissionView>
    </ToolbarButtons>
    <ColumnDefinitions Context="item">
        <PropertyColumn Property="c => c.Name" Title='@L["Role Name"]'/>
        <PropertyColumn Property="c => c.Description" Title='@L["Role Description"]'/>
        <PropertyColumn Property="c => c.IsDisabled" Title='@L["Status"]'>
            <Tag Color="@(item.IsDisabled == true ? "red" : "green")">
                @(item.IsDisabled == true ? L["Disabled"] : L["Enabled"])
            </Tag>
        </PropertyColumn>
        <PropertyColumn Property="c => c.CreatedAt" Title='@L["Created Time"]' Format="yyyy-MM-dd HH:mm:ss"/>
        <ActionColumn Title='@L["Actions"]' Width="180">
            <Space>
                <SpaceItem>
                    <PermissionView Code="@AppPermissions.System_Roles_Update">
                        <RoleEditDrawer Role="@item"/>
                    </PermissionView>
                </SpaceItem>
                <SpaceItem>
                    <PermissionView Code="@AppPermissions.System_Roles_Delete">
                        <Popconfirm Title='@L["Are you sure to delete this role?"]'
                                    OnConfirm="() => OnDelete(item)"
                                    OkText='@L["Confirm"]'
                                    CancelText='@L["Cancel"]'>
                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" Danger>
                                @L["Delete"]
                            </Button>
                        </Popconfirm>
                    </PermissionView>
                </SpaceItem>
            </Space>
        </ActionColumn>
    </ColumnDefinitions>
</PTable>

@code {
    private PTable<RoleListItemDto>? _pTable;
    private readonly SearchQueryParameters _searchModel = new();

    private async Task<(int Total, IEnumerable<RoleListItemDto> Data)> LoadDataAsync(
        QueryModel<RoleListItemDto> queryModel)
    {
        try
        {
            var response = await ApiClient.Api.Roles.GetAsync(config =>
            {
                config.QueryParameters.PageIndex = queryModel.PageIndex;
                config.QueryParameters.PageSize = queryModel.PageSize;
                config.QueryParameters.CountTotal = true;
                config.QueryParameters.Name = string.IsNullOrWhiteSpace(_searchModel.Name) ? null : _searchModel.Name;
            });

            if (response is { Success: true, Data: { } data })
            {
                return (data.Total ?? 0, data.Items?.ToList() ?? []);
            }

            _ = MessageService.ErrorAsync(response?.Message ?? $"{L["Failed to get role list"]}");
            return (0, []);
        }
        catch (Exception ex)
        {
            _ = MessageService.ErrorAsync($"{L["Failed to get role list"]}: {ex.Message}");
            return (0, []);
        }
    }

    private void OnRoleChangedAsync()
    {
        _pTable?.ReloadData();
    }

    private async Task OnDelete(RoleListItemDto role)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(role.RoleId))
            {
                _ = MessageService.ErrorAsync($"{L["Role ID cannot be empty"]}");
                return;
            }

            var response = await ApiClient.Api.Roles[role.RoleId].DeleteAsync();
            if (response is { Success: true })
            {
                _ = MessageService.SuccessAsync($"{L["Deleted successfully"]}");
                _pTable?.ReloadData();
            }
            else
            {
                _ = MessageService.ErrorAsync(response?.Message ?? $"{L["Delete failed"]}");
            }
        }
        catch (Exception ex)
        {
            _ = MessageService.ErrorAsync($"{L["Delete failed"]}: {ex.Message}");
        }
    }

}

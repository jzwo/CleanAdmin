@using UpdateRoleRequest = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceEndpointsRolesUpdateRoleInfoRequest
@using RoleListItemDto = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceApplicationQueriesRolesRoleListItemDto
@using CleanAdmin.Web.Client.ApiSdk
@inject ApiClient ApiClient
@inject IStringLocalizer<RoleEditDrawer> L

<PDrawerForm TModel="UpdateRoleRequest"
             Title='@L["Edit Role"]'
             Model="_model"
             LabelColSpan="8"
             OnSubmit="@HandleSubmitAsync"
             ContentClass="w-100 mr-auto"
             Width="@DrawerWidth">
    <Activator>
        <Button Size="@ButtonSize.Small" Type="@ButtonType.Link"
                OnClick="@OnOpenDrawer">
            @L["Edit"]
        </Button>
    </Activator>
    <ChildContent Context="model">
        <PFormItem Label='@L["Role Name"]' Required>
            <Input @bind-Value="@model.Name" Placeholder='@L["Please enter role name"]'/>
        </PFormItem>
        <PFormItem Label='@L["Role Description"]' Required>
            <Input @bind-Value="@model.Description" Placeholder='@L["Please enter role description"]'/>
        </PFormItem>
        <PFormItem Label='@L["Status"]' Required>
            <Select @bind-Value="@model.IsDisabled"
                    Placeholder='@L["Please select status"]'
                    TItemValue="bool?"
                    TItem="bool?">
                <SelectOptions>
                    <SelectOption Value="@((bool?)false)" Label='@L["Enabled"]'/>
                    <SelectOption Value="@((bool?)true)" Label='@L["Disabled"]'/>
                </SelectOptions>
            </Select>
        </PFormItem>
        <PermissionView Code="@AppPermissions.System_Roles_ManagePermissions">
            <RolePermissionDrawer Role="@Role" @bind-IsOpen="_permissionDrawerOpen"/>
        </PermissionView>
    </ChildContent>
</PDrawerForm>

@code {
    [Parameter, EditorRequired] public RoleListItemDto Role { get; set; } = new();
    private string DrawerWidth => _permissionDrawerOpen ? $"{480 + int.Parse(RolePermissionDrawer.DrawerWidth)}" : "480";
    private bool _permissionDrawerOpen;
    private UpdateRoleRequest _model = new();
    private string? _currentEditRoleId;

    private void OnOpenDrawer()
    {
        _currentEditRoleId = Role.RoleId;
        _model = new UpdateRoleRequest
        {
            Name = Role.Name,
            Description = Role.Description,
            IsDisabled = Role.IsDisabled
        };
    }

    private async Task<(bool, string?)> HandleSubmitAsync(UpdateRoleRequest model)
    {
        if (string.IsNullOrWhiteSpace(_currentEditRoleId))
        {
            return (false, $"{L["Role ID cannot be empty"]}");
        }

        var response = await ApiClient.Api.Roles[_currentEditRoleId].Info.PostAsync(model);
        return response is not { Success: true } ? (false, response?.Message) : (true, null);
    }

}

@using MenuPermissionTreeNodeDto = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceApplicationQueriesMenusMenuPermissionTreeNodeDto

<TreeNode TItem="string"
          Title="@(Node.MenuName ?? string.Empty)"
          Key="@NodeMenuId"
          IconTemplate="@NodeIconTemplate"
          DisableCheckbox="@IsDisabled">
    @if (Node.Children is { Count: > 0 } children)
    {
        @foreach (var child in children)
        {
            <RolePermissionTreeNode Node="child"/>
        }
    }
</TreeNode>

@code {
    [Parameter, EditorRequired] public MenuPermissionTreeNodeDto Node { get; set; }

    private string NodeMenuId => string.IsNullOrWhiteSpace(Node.MenuId) ? string.Empty : Node.MenuId;
    private bool IsDisabled => string.IsNullOrWhiteSpace(Node.PermissionCode);

    private RenderFragment<TreeNode<string>>? NodeIconTemplate => string.IsNullOrWhiteSpace(Node.Icon)
        ? null
        : _ => @<iconify-icon icon="@Node.Icon"></iconify-icon>;

}

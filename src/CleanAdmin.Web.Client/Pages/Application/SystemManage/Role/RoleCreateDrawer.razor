@using CreateRoleRequest = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceEndpointsRolesCreateRoleRequest
@using CleanAdmin.Web.Client.ApiSdk
@inject ApiClient ApiClient
@inject ILogger<RoleCreateDrawer> Logger

<PDrawerForm TModel="CreateRoleRequest"
             Title="新增角色"
             Model="_model"
             OnSubmit="@HandleSubmitAsync">
    <Activator>
        <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Plus">新增</Button>
    </Activator>
    <ChildContent Context="model">
        <PFormItem Label="角色名称"
                   Rules="@(new[] { new FormValidationRule { Required = true, Message = "请输入角色名称" } })">
            <Input @bind-Value="@model.Name" Placeholder="请输入角色名称"/>
        </PFormItem>
        <PFormItem Label="角色描述">
            <Input @bind-Value="@model.Description" Placeholder="请输入角色描述"/>
        </PFormItem>
        <PFormItem Label="状态"
                   Rules="@(new[] { new FormValidationRule { Required = true, Message = "请选择状态" } })">
            <Select @bind-Value="@model.IsDisabled"
                    Placeholder="请选择状态"
                    TItemValue="bool?"
                    TItem="bool?">
                <SelectOptions>
                    <SelectOption Value="@((bool?)false)" Label="启用"/>
                    <SelectOption Value="@((bool?)true)" Label="禁用"/>
                </SelectOptions>
            </Select>
        </PFormItem>
    </ChildContent>
</PDrawerForm>

@code {
    private readonly CreateRoleRequest _model = new() { IsDisabled = false };

    [Parameter] public EventCallback OnSuccess { get; set; }

    private async Task<(bool, string?)> HandleSubmitAsync(CreateRoleRequest model)
    {
        try
        {
            var response = await ApiClient.Api.Roles.PostAsync(model);
            if (response is not { Success: true })
            {
                return (false, response?.Message);
            }

            await OnSuccess.InvokeAsync();
            return (true, null);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "创建角色失败");
            return (false, ex.Message);
        }
    }

}

@using CreateRoleRequest = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceEndpointsRolesCreateRoleRequest
@using CleanAdmin.Web.Client.ApiSdk
@inject ApiClient ApiClient
@inject IStringLocalizer<RoleCreateDrawer> L

<Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Plus" OnClick="@OpenDrawer">@L["Create"]</Button>

<PDrawerForm TModel="CreateRoleRequest"
             Title='@L["Create Role"]'
             Model="_model"
             LabelColSpan="8"
             @bind-Visible="_visible"
             OnSubmit="@HandleSubmitAsync">
    <ChildContent Context="model">
        <PFormItem Label='@L["Role Name"]' Required>
            <Input @bind-Value="@model.Name" Placeholder='@L["Please enter role name"]'/>
        </PFormItem>
        <PFormItem Label='@L["Role Description"]' Required>
            <Input @bind-Value="@model.Description" Placeholder='@L["Please enter role description"]'/>
        </PFormItem>
        <PFormItem Label='@L["Status"]' Required>
            <Select @bind-Value="@model.IsDisabled"
                    Placeholder='@L["Please select status"]'
                    TItemValue="bool?"
                    TItem="bool?">
                <SelectOptions>
                    <SelectOption Value="@((bool?)false)" Label='@L["Enabled"]'/>
                    <SelectOption Value="@((bool?)true)" Label='@L["Disabled"]'/>
                </SelectOptions>
            </Select>
        </PFormItem>
    </ChildContent>
</PDrawerForm>

@code {
    private readonly CreateRoleRequest _model = new() { IsDisabled = false };
    private bool _visible;

    [Parameter] public EventCallback OnSuccess { get; set; }

    private void OpenDrawer()
    {
        _visible = true;
    }

    private async Task<(bool, string?)> HandleSubmitAsync(CreateRoleRequest model)
    {
        var response = await ApiClient.Api.Roles.PostAsync(model);
        if (response is not { Success: true })
        {
            return (false, response?.Message);
        }

        await OnSuccess.InvokeAsync();
        return (true, null);
    }

}

@using CleanAdmin.Web.Client.ApiSdk
@using MenuPermissionTreeNodeDto = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceApplicationQueriesMenusMenuPermissionTreeNodeDto
@using RoleListItemDto = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceApplicationQueriesRolesRoleListItemDto
@using UpdateRolePermissionsRequest = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceEndpointsRolesUpdateRolePermissionsRequest
@inject ApiClient ApiClient
@inject IMessageService MessageService

<PDrawerForm TModel="UpdateRolePermissionsRequest"
             Title="分配权限"
             Model="_model"
             Width="@DrawerWidth"
             OnClosed="@(() => IsOpenChanged.InvokeAsync(false))"
             DisableTableReload
             OnSubmit="@HandleSubmitAsync">
    <Activator>
        <Button OnClick="@OnOpenDrawerAsync">
            分配权限
        </Button>
    </Activator>
    <ChildContent>
        @if (_loadingPermissions)
        {
            <div class="py-4 text-center">
                <Spin/>
            </div>
        }
        else if (_permissionTree.Count == 0)
        {
            <Empty/>
        }
        else
        {
            <div>
                <div class="mb-3 flex items-center gap-2">
                    <Search @bind-Value="_searchKey"
                            Placeholder="搜索权限名称"
                            BindOnInput
                            AllowClear/>
                    <Button OnClick="@CheckAllPermissions">全选</Button>
                    <Button OnClick="@ClearAllPermissions">清空</Button>
                </div>

                <Tree TItem="string"
                      ShowIcon
                      Checkable
                      CheckOnClickNode="false"
                      DefaultExpandAll
                      SearchValue="@_searchKey"
                      MatchedClass="text-red-500"
                      @bind-CheckedKeys="_checkedKeys"
                      OnCheck="OnTreeCheck">
                    <Nodes>
                        @foreach (var node in _permissionTree)
                        {
                            <RolePermissionTreeNode Node="node"/>
                        }
                    </Nodes>
                </Tree>
            </div>
        }
    </ChildContent>
</PDrawerForm>

@code {
    [Parameter, EditorRequired] public RoleListItemDto Role { get; set; } = new();
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    public const string DrawerWidth = "400";
    private readonly UpdateRolePermissionsRequest _model = new();
    private string? _currentRoleId;
    private bool _loadingPermissions;
    private string? _searchKey;
    private List<MenuPermissionTreeNodeDto> _permissionTree = [];
    private string[] _checkedKeys = [];
    private readonly Dictionary<string, string?> _menuIdToPermissionCode = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _permissionCodeToMenuId = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _forcedCheckedMenuIds = new(StringComparer.OrdinalIgnoreCase);

    private async Task OnOpenDrawerAsync()
    {
        await IsOpenChanged.InvokeAsync(true);
        _currentRoleId = Role.RoleId;

        if (string.IsNullOrWhiteSpace(_currentRoleId))
        {
            _permissionTree = [];
            _checkedKeys = [];
            await MessageService.ErrorAsync("角色ID不能为空");
            return;
        }

        _loadingPermissions = true;

        try
        {
            var permissionTreeTask = ApiClient.Api.Menus.Permissions.Tree.GetAsync();
            var rolePermissionsTask = ApiClient.Api.Roles[_currentRoleId].Permissions.GetAsync();

            await Task.WhenAll(permissionTreeTask, rolePermissionsTask);

            var permissionTreeResponse = await permissionTreeTask;
            var rolePermissionsResponse = await rolePermissionsTask;

            if (permissionTreeResponse is not { Success: true })
            {
                _permissionTree = [];
                _checkedKeys = [];
                await MessageService.ErrorAsync(permissionTreeResponse?.Message ?? "获取权限树失败");
                return;
            }

            _permissionTree = permissionTreeResponse.Data ?? [];
            BuildNodeIndex();

            var rolePermissionCodes = rolePermissionsResponse?.Data?.PermissionCodes ?? [];
            var checkedMenuIds = new HashSet<string>(_forcedCheckedMenuIds, StringComparer.OrdinalIgnoreCase);

            foreach (var permissionCode in rolePermissionCodes.Where(permissionCode => !string.IsNullOrWhiteSpace(permissionCode)))
            {
                if (_permissionCodeToMenuId.TryGetValue(permissionCode, out var menuId))
                {
                    checkedMenuIds.Add(menuId);
                }
            }

            _checkedKeys = checkedMenuIds.ToArray();
        }
        catch (Exception ex)
        {
            _permissionTree = [];
            _checkedKeys = [];
            await MessageService.ErrorAsync($"加载权限数据失败: {ex.Message}");
        }
        finally
        {
            _loadingPermissions = false;
        }
    }

    private void BuildNodeIndex()
    {
        _menuIdToPermissionCode.Clear();
        _permissionCodeToMenuId.Clear();
        _forcedCheckedMenuIds.Clear();

        foreach (var node in _permissionTree)
        {
            BuildNodeIndex(node);
        }
    }

    private void BuildNodeIndex(MenuPermissionTreeNodeDto node)
    {
        var menuId = GetNodeMenuId(node);
        if (!string.IsNullOrWhiteSpace(menuId))
        {
            if (!_menuIdToPermissionCode.ContainsKey(menuId))
            {
                _menuIdToPermissionCode[menuId] = node.PermissionCode;
            }

            if (string.IsNullOrWhiteSpace(node.PermissionCode))
            {
                _forcedCheckedMenuIds.Add(menuId);
            }
            else
            {
                _permissionCodeToMenuId[node.PermissionCode] = menuId;
            }
        }

        if (node.Children is null || node.Children.Count == 0)
        {
            return;
        }

        foreach (var child in node.Children)
        {
            BuildNodeIndex(child);
        }
    }

    private static string GetNodeMenuId(MenuPermissionTreeNodeDto node)
    {
        return string.IsNullOrWhiteSpace(node.MenuId) ? string.Empty : node.MenuId;
    }

    private void OnTreeCheck(TreeEventArgs<string> _)
    {
        _checkedKeys = _checkedKeys
            .Concat(_forcedCheckedMenuIds)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private void CheckAllPermissions()
    {
        _checkedKeys = _menuIdToPermissionCode
            .Where(x => !string.IsNullOrWhiteSpace(x.Key) && !string.IsNullOrWhiteSpace(x.Value))
            .Select(x => x.Key)
            .Concat(_forcedCheckedMenuIds)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private void ClearAllPermissions()
    {
        _checkedKeys = _forcedCheckedMenuIds.ToArray();
    }

    private async Task<(bool, string?)> HandleSubmitAsync(UpdateRolePermissionsRequest _)
    {
        try
        {
            var finalCheckedMenuIds = _checkedKeys
                .Concat(_forcedCheckedMenuIds)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase);

            var permissionCodes = finalCheckedMenuIds
                .Select(menuId => _menuIdToPermissionCode.GetValueOrDefault(menuId))
                .Where(permissionCode => !string.IsNullOrWhiteSpace(permissionCode))
                .Select(permissionCode => permissionCode!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            var request = new UpdateRolePermissionsRequest
            {
                PermissionCodes = permissionCodes
            };

            var response = await ApiClient.Api.Roles[_currentRoleId].Permissions.PostAsync(request);
            return response is not { Success: true } ? (false, response?.Message) : (true, null);
        }
        catch (Exception ex)
        {
            return (false, ex.Message);
        }
    }

}

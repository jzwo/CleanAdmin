@page "/SystemManage/Menu"

@using AntDesign.TableModels
@using CleanAdmin.Web.Client.ApiSdk
@using MenuTreeNodeDto = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceApplicationQueriesMenusMenuTreeNodeDto
@using CreateMenuRequest = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceEndpointsMenusCreateMenuRequest
@using UpdateMenuRequest = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminApiServiceEndpointsMenusUpdateMenuRequest
@using MenuType = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminDomainAggregatesModelMenuAggregateMenuType
@using MenuStatus = CleanAdmin.Web.Client.ApiSdk.Models.CleanAdminDomainAggregatesModelMenuAggregateMenuStatus
@inject ApiClient ApiClient
@inject IMessageService MessageService
@inject IStringLocalizer<Menu> L

<PageTitle>@L["Menu Management"]</PageTitle>

<PTable @ref="_pTable" TItem="MenuTreeNodeDto"
        Title='@L["Menu List"]'
        HidePagination="true"
        TreeChildren="@(x => x.Children ?? [])"
        OnLoadData="LoadMenuTreeAsync"
        DefaultExpandAllRows>
    <ToolbarButtons>
        <PermissionView Code="@AppPermissions.System_Menus_Create">
            <PDrawerForm TModel="CreateMenuRequest"
                         Title='@L["Create Menu"]'
                         Model="_createModel"
                         OnSubmit="@HandleCreateAsync">
                <Activator>
                    <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Plus">@L["Create"]</Button>
                </Activator>
                <ChildContent Context="model">
                    <PFormItem Label='@L["Menu Name"]' Required>
                        <Input @bind-Value="@model.MenuName" Placeholder='@L["Please enter menu name"]'/>
                    </PFormItem>
                    <PFormItem Label='@L["Menu Type"]' Required>
                        <EnumSelect TEnum="MenuType?" @bind-Value="@model.MenuType" Placeholder='@L["Please select menu type"]'/>
                    </PFormItem>
                    <PFormItem Label='@L["Parent Menu"]'>
                        <TreeSelect TItem="MenuTreeNodeDto"
                                    TItemValue="string"
                                    DataSource="@_menuTreeData"
                                    @bind-Value="@_selectedParentId"
                                    TitleExpression="@(x => x.DataItem.MenuName)"
                                    KeyExpression="@(x => x.DataItem.MenuId)"
                                    ChildrenExpression="@(x => x.DataItem.Children)"
                                    Placeholder='@L["Please select parent menu (leave empty for top-level)"]'
                                    AllowClear/>
                    </PFormItem>
                    <PFormItem Label='@L["Route Path"]'>
                        <Input @bind-Value="@model.RoutePath" Placeholder='@L["Please enter route path"]'/>
                    </PFormItem>
                    <PFormItem Label='@L["Component Path"]'>
                        <Input @bind-Value="@model.ComponentPath" Placeholder='@L["Please enter component path"]'/>
                    </PFormItem>
                    <PFormItem Label='@L["Icon"]'>
                        <AntDesign.Input @bind-Value="@model.Icon" Placeholder='@L["Please enter icon"]'>
                            <AddOnAfter>
                                <iconify-icon icon="@model.Icon"></iconify-icon>
                            </AddOnAfter>
                        </AntDesign.Input>
                    </PFormItem>
                    <PFormItem Label='@L["Sort Order"]' Required>
                        <AntDesign.InputNumber @bind-Value="@model.SortOrder" Min="0" Placeholder='@L["Please enter sort order"]'/>
                    </PFormItem>
                    <PFormItem Label='@L["Permission Code"]'>
                        <Input @bind-Value="@model.PermissionCode" Placeholder='@L["Please enter permission code"]'/>
                    </PFormItem>
                </ChildContent>
            </PDrawerForm>
        </PermissionView>
    </ToolbarButtons>
    <ColumnDefinitions>
        <PropertyColumn Property="c => c.MenuName" Title='@L["Menu Name"]'>
            <Space Class="flex items-center">
                <SpaceItem Class="flex items-center">
                    @if (!string.IsNullOrEmpty(context.Icon))
                    {
                        <iconify-icon icon="@context.Icon"></iconify-icon>
                    }
                </SpaceItem>
                <SpaceItem>@context.MenuName</SpaceItem>
            </Space>
        </PropertyColumn>
        <PropertyColumn Width="12%" Property="c => c.MenuType" Title='@L["Menu Type"]'>
            <Tag Color="@GetMenuTypeColor(context.MenuType)">@GetMenuTypeText(context.MenuType)</Tag>
        </PropertyColumn>
        <PropertyColumn Width="20%" Property="c => c.RoutePath" Title='@L["Route Path"]'/>
        <PropertyColumn Width="8%" Property="c => c.ComponentPath" Title='@L["Component Path"]'/>
        <PropertyColumn Width="8%" Property="c => c.SortOrder" Title='@L["Sort Order"]'/>
        <PropertyColumn Width="8%" Property="c => c.IsVisible" Title='@L["Visibility"]'>
            <Tag
                Color="@(context.IsVisible == true ? "green" : "red")">@(context.IsVisible == true ? L["Visible"] : L["Hidden"])</Tag>
        </PropertyColumn>
        <PropertyColumn Width="8%" Property="c => c.Status" Title='@L["Status"]'>
            <Tag
                Color="@(context.Status == MenuStatus.Enabled ? "green" : "red")">@(context.Status == MenuStatus.Enabled ? L["Enabled"] : L["Disabled"])</Tag>
        </PropertyColumn>
        <ActionColumn Title='@L["Actions"]' Width="12%">
            <Space>
                <SpaceItem>
                    <PermissionView Code="@AppPermissions.System_Menus_Update">
                        @* 编辑菜单抽屉表单 *@
                        <PDrawerForm TModel="UpdateMenuRequest"
                                     Title='@L["Edit Menu"]'
                                     Model="_editModel"
                                     OnSubmit="@HandleEditAsync">
                            <Activator>
                                <Button Size="@ButtonSize.Small" Type="@ButtonType.Link"
                                        OnClick="@(() => OnOpenEditDrawer(context))">
                                    @L["Edit"]
                                </Button>
                            </Activator>
                            <ChildContent Context="model">
                                <PFormItem Label='@L["Menu Name"]' Required>
                                    <Input @bind-Value="@model.MenuName" Placeholder='@L["Please enter menu name"]'/>
                                </PFormItem>
                                <PFormItem Label='@L["Route Path"]'>
                                    <Input @bind-Value="@model.RoutePath" Placeholder='@L["Please enter route path"]'/>
                                </PFormItem>
                                <PFormItem Label='@L["Component Path"]'>
                                    <Input @bind-Value="@model.ComponentPath" Placeholder='@L["Please enter component path"]'/>
                                </PFormItem>
                                <PFormItem Label='@L["Icon"]'>
                                    <AntDesign.Input @bind-Value="@model.Icon" Placeholder='@L["Please enter icon"]'>
                                        <AddOnAfter>
                                            <iconify-icon icon="@model.Icon"></iconify-icon>
                                        </AddOnAfter>
                                    </AntDesign.Input>
                                </PFormItem>
                                <PFormItem Label='@L["Permission Code"]'>
                                    <Input @bind-Value="@model.PermissionCode" Placeholder='@L["Please enter permission code"]'/>
                                </PFormItem>
                            </ChildContent>
                        </PDrawerForm>
                    </PermissionView>
                </SpaceItem>
                <SpaceItem>
                    <PermissionView Code="@AppPermissions.System_Menus_Delete">
                        <Popconfirm Title='@L["Are you sure to delete this menu?"]'
                                    OnConfirm="() => OnDelete(context)"
                                    OkText='@L["Confirm"]'
                                    CancelText='@L["Cancel"]'>
                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" Danger>
                                @L["Delete"]
                            </Button>
                        </Popconfirm>
                    </PermissionView>
                </SpaceItem>
            </Space>
        </ActionColumn>
    </ColumnDefinitions>
</PTable>


@code {
    private PTable<MenuTreeNodeDto>? _pTable;
    private List<MenuTreeNodeDto> _menuTreeData = new();
    private readonly CreateMenuRequest _createModel = new();
    private UpdateMenuRequest _editModel = new();
    private string? _currentEditMenuId;
    private string? _selectedParentId;

    /// <summary>
    /// 加载菜单树数据
    /// </summary>
    private async Task<(int Total, IEnumerable<MenuTreeNodeDto> Data)> LoadMenuTreeAsync(QueryModel<MenuTreeNodeDto> queryModel)
    {
        try
        {
            var response = await ApiClient.Api.Menus.Tree.All.GetAsync();
            if (response is { Success: true, Data: { } data })
            {
                _menuTreeData = data;
                return (data.Count, data);
            }
            else
            {
                await MessageService.ErrorAsync(response?.Message ?? $"{L["Failed to get menu tree"]}");
                return (0, []);
            }
        }
        catch (Exception ex)
        {
            await MessageService.ErrorAsync($"{L["Failed to get menu tree"]}: {ex.Message}");
            return (0, []);
        }
    }


    /// <summary>
    /// 处理新增菜单
    /// </summary>
    private async Task<(bool, string?)> HandleCreateAsync(CreateMenuRequest model)
    {
        // 设置父菜单ID
        model.ParentId = _selectedParentId;

        var response = await ApiClient.Api.Menus.PostAsync(model);
        if (response is { Success: true })
        {
            _selectedParentId = null;
            return (true, null);
        }

        return (false, response?.Message);
    }

    /// <summary>
    /// 打开编辑抽屉
    /// </summary>
    private void OnOpenEditDrawer(MenuTreeNodeDto menu)
    {
        _currentEditMenuId = menu.MenuId;
        _editModel = new UpdateMenuRequest
        {
            MenuName = menu.MenuName,
            RoutePath = menu.RoutePath,
            ComponentPath = menu.ComponentPath,
            Icon = menu.Icon,
            PermissionCode = menu.PermissionCode
        };
    }

    /// <summary>
    /// 处理编辑菜单
    /// </summary>
    private async Task<(bool, string?)> HandleEditAsync(UpdateMenuRequest model)
    {
        if (string.IsNullOrEmpty(_currentEditMenuId))
        {
            return (false, $"{L["Menu ID cannot be empty"]}");
        }

        var response = await ApiClient.Api.Menus[_currentEditMenuId].PutAsync(model);
        return response is { Success: true } ? (true, null) : (false, response?.Message);
    }

    /// <summary>
    /// 删除菜单
    /// </summary>
    private async Task OnDelete(MenuTreeNodeDto menu)
    {
        try
        {
            var response = await ApiClient.Api.Menus[menu.MenuId].DeleteAsync();
            if (response is { Success: true })
            {
                await MessageService.SuccessAsync($"{L["Deleted successfully"]}");
                _pTable?.ReloadData();
            }
            else
            {
                await MessageService.ErrorAsync(response?.Message ?? $"{L["Delete failed"]}");
            }
        }
        catch (Exception ex)
        {
            await MessageService.ErrorAsync($"{L["Delete failed"]}: {ex.Message}");
        }
    }

    /// <summary>
    /// 获取菜单类型颜色
    /// </summary>
    private string GetMenuTypeColor(MenuType? menuType)
    {
        return menuType switch
        {
            MenuType.Directory => "blue",
            MenuType.Menu => "green",
            MenuType.Button => "orange",
            _ => "default"
        };
    }

    /// <summary>
    /// 获取菜单类型文本
    /// </summary>
    private string GetMenuTypeText(MenuType? menuType)
    {
        return menuType switch
        {
            MenuType.Directory => $"{L["Directory"]}",
            MenuType.Menu => $"{L["Menu"]}",
            MenuType.Button => $"{L["Button"]}",
            _ => $"{L["Unknown"]}"
        };
    }

}

@using OneOf;
@inherits FormItem
@implements IDisposable

@if (UseGrid)
{
    <GridCol Span="@ActualSpan"
             Xs="@ActualXs"
             Sm="@ActualSm"
             Md="@ActualMd"
             Lg="@ActualLg"
             Xl="@ActualXl"
             Xxl="@ActualXxl"
             Class="@HiddenClass">
        @BaseContent
    </GridCol>
}
else if (IsVisible)
{
    @BaseContent
}
else
{
    <div class="hidden">
        @BaseContent
    </div>
}

@code {

    private RenderFragment BaseContent => builder => base.BuildRenderTree(builder);

    /// <summary>
    /// 父级 PForm 组件
    /// </summary>
    [CascadingParameter]
    public IPForm? Parent { get; set; }

    /// <summary>
    /// 是否总是显示（不受折叠影响）
    /// </summary>
    [Parameter]
    public bool AlwaysShow { get; set; }

    /// <summary>
    /// 判断是否应该显示
    /// </summary>
    private bool IsVisible => Parent?.ShouldShowField(this) ?? true;

    /// <summary>
    /// 是否使用栅格布局
    /// </summary>
    private bool UseGrid => !(Parent?.DisableGrid ?? false);

    /// <summary>
    /// 隐藏类名（用于 GridCol）
    /// </summary>
    private string? HiddenClass => IsVisible ? null : "hidden";

    /// <summary>
    /// 初始化并注册字段
    /// </summary>
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Parent?.AddField(this);
    }

    public new void Dispose()
    {
        Parent?.RemoveField(this);
    }

    #region GridCol Parameters - 计算属性

    private OneOf<string, int> ActualSpan => _spanSet ? Span : Parent?.ItemSpan ?? Span;
    private OneOf<int, EmbeddedProperty> ActualXs => _xsSet ? Xs : Parent?.ItemXs ?? Xs;
    private OneOf<int, EmbeddedProperty> ActualSm => _smSet ? Sm : Parent?.ItemSm ?? Sm;
    private OneOf<int, EmbeddedProperty> ActualMd => _mdSet ? Md : Parent?.ItemMd ?? Md;
    private OneOf<int, EmbeddedProperty> ActualLg => _lgSet ? Lg : Parent?.ItemLg ?? Lg;
    private OneOf<int, EmbeddedProperty> ActualXl => _xlSet ? Xl : Parent?.ItemXl ?? Xl;
    private OneOf<int, EmbeddedProperty> ActualXxl => _xxlSet ? Xxl : Parent?.ItemXxl ?? Xxl;

    #endregion

    #region GridCol Parameters

    private bool _spanSet;
    private bool _xsSet;
    private bool _smSet;
    private bool _mdSet;
    private bool _lgSet;
    private bool _xlSet;
    private bool _xxlSet;

    /// <summary>
    /// 栅格占位格数 (1-24)
    /// </summary>
    [Parameter]
    public OneOf<string, int> Span
    {
        get;
        set
        {
            field = value;
            _spanSet = true;
        }
    } = 24;

    /// <summary>
    /// &lt;576px 响应式栅格
    /// </summary>
    [Parameter]
    public OneOf<int, EmbeddedProperty> Xs
    {
        get;
        set
        {
            field = value;
            _xsSet = true;
        }
    }

    /// <summary>
    /// ≥576px 响应式栅格
    /// </summary>
    [Parameter]
    public OneOf<int, EmbeddedProperty> Sm
    {
        get;
        set
        {
            field = value;
            _smSet = true;
        }
    }

    /// <summary>
    /// ≥768px 响应式栅格
    /// </summary>
    [Parameter]
    public OneOf<int, EmbeddedProperty> Md
    {
        get;
        set
        {
            field = value;
            _mdSet = true;
        }
    }

    /// <summary>
    /// ≥992px 响应式栅格
    /// </summary>
    [Parameter]
    public OneOf<int, EmbeddedProperty> Lg
    {
        get;
        set
        {
            field = value;
            _lgSet = true;
        }
    }

    /// <summary>
    /// ≥1200px 响应式栅格
    /// </summary>
    [Parameter]
    public OneOf<int, EmbeddedProperty> Xl
    {
        get;
        set
        {
            field = value;
            _xlSet = true;
        }
    }

    /// <summary>
    /// ≥1600px 响应式栅格
    /// </summary>
    [Parameter]
    public OneOf<int, EmbeddedProperty> Xxl
    {
        get;
        set
        {
            field = value;
            _xxlSet = true;
        }
    }

    #endregion

}



@using System.Globalization
@using Microsoft.AspNetCore.Localization
@using CleanAdmin.Web.Client.Services
@inject ThemeService ThemeService

<!DOCTYPE html>
<html lang="@Culture" class="@(IsDark ? "dark" : null)">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <ResourcePreloader/>
    <link rel="stylesheet" href="@Assets["tailwind.css"]"/>
    <link rel="stylesheet" href="@Assets["CleanAdmin.Web.styles.css"]"/>
    <link id="@ThemeService.ThemeLinkId" rel="stylesheet" href="@(_themeCssPath)"/>
    <ImportMap/>
    <HeadOutlet @rendermode="PageRenderMode"/>
    <title>CleanAdmin</title>
</head>

<body>
    <Routes @rendermode="PageRenderMode"/>
    <AntContainer @rendermode="PageRenderMode"/>
    <ReconnectModal/>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/AntDesign/js/ant-design-blazor.js"]"></script>
    <script src="@Assets["_content/Bit.Butil/bit-butil.js"]"></script>
    <script src="@Assets["js/ant-design-tweaks.js"]"></script>
    <script src="@Assets["https://cdn.jsdelivr.net/npm/iconify-icon@3.0.0/dist/iconify-icon.min.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    private static IComponentRenderMode PageRenderMode => /*InteractiveAuto*/InteractiveServer;

    private ThemeMode _currentThemeMode = ThemeMode.Dark;
    private bool IsDark => _currentThemeMode == ThemeMode.Dark;
    private string _themeCssPath = string.Empty;

    private static string Culture => CultureInfo.CurrentCulture.IetfLanguageTag;

    protected override void OnInitialized()
    {
        // 设置本地化 Cookie
        HttpContext.Response.Cookies.Append(
            CookieRequestCultureProvider.DefaultCookieName,
            CookieRequestCultureProvider.MakeCookieValue(
                new RequestCulture(
                    CultureInfo.CurrentCulture,
                    CultureInfo.CurrentUICulture)));
    }

    protected override async Task OnInitializedAsync()
    {
        _currentThemeMode = await ThemeService.GetThemeAsync();
        _themeCssPath = ThemeService.GetThemeCssPath(_currentThemeMode);
    }

}